{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "azuredatafactoryycourseganesh"
		},
		"Linked Service DL_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Linked Service DL'"
		},
		"Linked Service DL_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageaccountganesh.dfs.core.windows.net/"
		},
		"LinkedService_Github_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"Trigger_Manager_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/43d77d6d-7bd2-41fc-a377-8752c9f887da/resourceGroups/RG-ADFCourse/providers/Microsoft.Storage/storageAccounts/storageaccountganesh"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "azuredatafactoryycourseganesh_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Linked Service DL_accountKey": {
						"value": "[parameters('Linked Service DL_accountKey')]"
					},
					"Linked Service DL_properties_typeProperties_url": {
						"value": "[parameters('Linked Service DL_properties_typeProperties_url')]"
					},
					"LinkedService_Github_properties_typeProperties_url": {
						"value": "[parameters('LinkedService_Github_properties_typeProperties_url')]"
					},
					"Trigger_Manager_properties_typeProperties_scope": {
						"value": "[parameters('Trigger_Manager_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}