{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "aazuredatafactoryproganesh"
		},
		"Linked Service_DataLake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Linked Service_DataLake'"
		},
		"Linked Service_Database_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Linked Service_Database'"
		},
		"Linked Service_DataLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://datafacrorystoragee.dfs.core.windows.net/"
		},
		"Linked Service_Database_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dfprooserver.database.windows.net"
		},
		"Linked Service_Database_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dfprodb"
		},
		"Linked Service_Database_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminganesh"
		},
		"ls_rest_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pokeapi.co/api/v2/pokemon"
		},
		"Schedule_properties_Scheduled Pipeline_parameters_schema": {
			"type": "string",
			"defaultValue": "source"
		},
		"Schedule_properties_Scheduled Pipeline_parameters_table": {
			"type": "string",
			"defaultValue": "Orders"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "aazuredatafactoryproganesh_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Linked Service_DataLake_accountKey": {
						"value": "[parameters('Linked Service_DataLake_accountKey')]"
					},
					"Linked Service_Database_password": {
						"value": "[parameters('Linked Service_Database_password')]"
					},
					"Linked Service_DataLake_properties_typeProperties_url": {
						"value": "[parameters('Linked Service_DataLake_properties_typeProperties_url')]"
					},
					"Linked Service_Database_properties_typeProperties_server": {
						"value": "[parameters('Linked Service_Database_properties_typeProperties_server')]"
					},
					"Linked Service_Database_properties_typeProperties_database": {
						"value": "[parameters('Linked Service_Database_properties_typeProperties_database')]"
					},
					"Linked Service_Database_properties_typeProperties_userName": {
						"value": "[parameters('Linked Service_Database_properties_typeProperties_userName')]"
					},
					"ls_rest_properties_typeProperties_url": {
						"value": "[parameters('ls_rest_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "aazuredatafactoryproganesh_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Schedule_properties_Scheduled Pipeline_parameters_schema": {
						"value": "[parameters('Schedule_properties_Scheduled Pipeline_parameters_schema')]"
					},
					"Schedule_properties_Scheduled Pipeline_parameters_table": {
						"value": "[parameters('Schedule_properties_Scheduled Pipeline_parameters_table')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'aazuredatafactoryproganesh_ArmTemplate_0')]"
			]
		}
	]
}